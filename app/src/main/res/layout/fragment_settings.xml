<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbSettings"
        style="@style/Title"
        app:title="@string/settings" />

    <!-- Поделиться приложением -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/theme_switch"
        style="@style/Settings"
        android:text="@string/dark_theme"
        app:thumbTint="?attr/switch_thumb"
        app:trackTint="?attr/switch_track" />

    <!-- Поделиться приложением -->

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_share"
        style="@style/Settings"
        android:drawableEnd="@drawable/ic_share_24"
        android:text="@string/share_app" />

    <!-- Написать в поддержку -->

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_support"
        style="@style/Settings"
        android:drawableEnd="@drawable/ic_support_24"
        android:text="@string/write_to_support" />

    <!-- Пользовательское соглашение -->

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_agreement"
        style="@style/Settings"
        android:drawableEnd="@drawable/ic_arrow_agreement_24"
        android:text="@string/user_agreement" />

</LinearLayout>